<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
   
   <properties>
      <revision>0.4.0-SNAPSHOT</revision>
   </properties>

   <parent>
      <groupId>com.kingsrook</groupId>
      <artifactId>qbit-build-parent</artifactId>
      <version>2.0.0</version>
   </parent>

   <groupId>com.kingsrook.qbits</groupId>
   <artifactId>qbit-webhooks</artifactId>
   <version>${revision}</version>
   <packaging>jar</packaging>   

   <name>QBit Webhooks</name>
   <description>Webhook implementation for QQQ applications, enabling real-time event notifications to external systems and partners</description>
   <url>https://github.com/Kingsrook/qbit-webhooks</url>

   <modelVersion>4.0.0</modelVersion>

   <licenses>
      <license>
         <name>Apache License, Version 2.0</name>
         <url>https://www.apache.org/licenses/LICENSE-2.0</url>
         <distribution>repo</distribution>
      </license>
   </licenses>

   <developers>
      <developer>
         <id>kingsrook</id>
         <name>Kingsrook Team</name>
         <email>contact@kingsrook.com</email>
         <organization>Kingsrook, LLC</organization>
         <organizationUrl>https://kingsrook.com</organizationUrl>
      </developer>
   </developers>

   <scm>
      <connection>scm:git:git://github.com/Kingsrook/qbit-webhooks.git</connection>
      <developerConnection>scm:git:ssh://github.com:Kingsrook/qbit-webhooks.git</developerConnection>
      <url>https://github.com/Kingsrook/qbit-webhooks</url>
      <tag>HEAD</tag>
   </scm>

   <dependencyManagement>
      <dependencies>
         <dependency>
            <groupId>org.junit</groupId>
            <artifactId>junit-bom</artifactId>
            <version>5.10.0</version>
            <type>pom</type>
            <scope>import</scope>
         </dependency>
      </dependencies>
   </dependencyManagement>

   <dependencies>
      <dependency>
         <groupId>com.kingsrook.qqq</groupId>
         <artifactId>qqq-backend-core</artifactId>
      </dependency>
      <dependency>
         <groupId>com.kingsrook.qqq</groupId>
         <artifactId>qqq-middleware-api</artifactId> 
      </dependency>

      <dependency>
         <groupId>org.junit.jupiter</groupId>
         <artifactId>junit-jupiter</artifactId>
         <scope>test</scope>
      </dependency>
      <dependency>
         <groupId>org.assertj</groupId>
         <artifactId>assertj-core</artifactId>
         <version>3.27.7</version>
         <scope>test</scope>
      </dependency>
   </dependencies>

   <profiles>
      <!-- Opt-in check against the next qqq line: mvn -B verify -Pqqq-snapshot       -->
      <!-- (override the version with -Dqqq.snapshot.version=...).  Default builds   -->
      <!-- take the qqq version only from qbit-build-parent.                         -->
      <profile>
         <id>qqq-snapshot</id>
         <properties>
            <qqq.snapshot.version>4.1.0-SNAPSHOT</qqq.snapshot.version>
         </properties>
         <dependencyManagement>
            <dependencies>
               <dependency>
                  <groupId>com.kingsrook.qqq</groupId>
                  <artifactId>qqq-bom-pom</artifactId>
                  <version>${qqq.snapshot.version}</version>
                  <type>pom</type>
                  <scope>import</scope>
               </dependency>
            </dependencies>
         </dependencyManagement>
         <repositories>
            <repository>
               <id>sonatype-snapshots</id>
               <url>https://central.sonatype.com/repository/maven-snapshots/</url>
               <releases>
                  <enabled>false</enabled>
               </releases>
               <snapshots>
                  <enabled>true</enabled>
               </snapshots>
            </repository>
         </repositories>
      </profile>
   </profiles>

</project>
