<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

   <properties>
      <revision>1.0.0-SNAPSHOT</revision>
      <maven.compiler.source>21</maven.compiler.source>
      <maven.compiler.target>21</maven.compiler.target>
      <jacoco.version>0.8.15</jacoco.version>
      <h2.version>2.2.224</h2.version>
   </properties>

   <parent>
      <groupId>com.kingsrook</groupId>
      <artifactId>qbit-build-parent</artifactId>
      <version>2.0.0</version>
   </parent>

   <groupId>com.kingsrook.qbits</groupId>
   <artifactId>qbit-webhooks</artifactId>
   <version>${revision}</version>
   <packaging>jar</packaging>

   <name>QBit Webhooks</name>
   <description>QBit for signed, SSRF-safe outbound webhooks from QQQ applications: table, process, ESB and custom events, subscriptions, retries, dead letters and endpoint health</description>
   <url>https://github.com/QRun-IO/qbit-webhooks</url>

   <modelVersion>4.0.0</modelVersion>

   <licenses>
      <license>
         <name>Apache License, Version 2.0</name>
         <url>https://www.apache.org/licenses/LICENSE-2.0</url>
         <distribution>repo</distribution>
      </license>
   </licenses>

   <developers>
      <developer>
         <id>kingsrook</id>
         <name>Kingsrook Team</name>
         <email>contact@kingsrook.com</email>
         <organization>Kingsrook, LLC</organization>
         <organizationUrl>https://kingsrook.com</organizationUrl>
      </developer>
   </developers>

   <scm>
      <connection>scm:git:git://github.com/QRun-IO/qbit-webhooks.git</connection>
      <developerConnection>scm:git:ssh://github.com:QRun-IO/qbit-webhooks.git</developerConnection>
      <url>https://github.com/QRun-IO/qbit-webhooks</url>
      <tag>HEAD</tag>
   </scm>

   <dependencies>
      <dependency>
         <groupId>com.kingsrook.qqq</groupId>
         <artifactId>qqq-backend-core</artifactId>
      </dependency>

      <!-- Optional: render payloads through a QQQ API version (subscription apiName / apiVersion). -->
      <dependency>
         <groupId>com.kingsrook.qqq</groupId>
         <artifactId>qqq-middleware-api</artifactId>
         <optional>true</optional>
      </dependency>

      <!-- Optional: consume ESB topics (WebhooksEsbSource). -->
      <dependency>
         <groupId>com.kingsrook.qqq</groupId>
         <artifactId>qqq-esb</artifactId>
         <optional>true</optional>
      </dependency>

      <dependency>
         <groupId>com.kingsrook.qqq</groupId>
         <artifactId>qqq-backend-module-rdbms</artifactId>
         <scope>test</scope>
      </dependency>
      <dependency>
         <groupId>com.h2database</groupId>
         <artifactId>h2</artifactId>
         <version>${h2.version}</version>
         <scope>test</scope>
      </dependency>
      <dependency>
         <groupId>org.junit.jupiter</groupId>
         <artifactId>junit-jupiter</artifactId>
         <scope>test</scope>
      </dependency>
      <dependency>
         <groupId>org.assertj</groupId>
         <artifactId>assertj-core</artifactId>
         <version>3.27.7</version>
         <scope>test</scope>
      </dependency>
   </dependencies>

   <build>
      <plugins>
         <!-- TEMPORARY (1.0 PR): the 0.x sources stay in the tree until their removal is approved; they are not compiled. -->
         <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
               <excludes>
                  <exclude>com/kingsrook/qbits/webhooks/actions/**</exclude>
                  <exclude>com/kingsrook/qbits/webhooks/model/**</exclude>
                  <exclude>com/kingsrook/qbits/webhooks/tables/**</exclude>
                  <exclude>com/kingsrook/qbits/webhooks/registry/WebhooksRegistryEnricherPlugin.java</exclude>
                  <exclude>com/kingsrook/qbits/webhooks/registry/WebhooksRegistryValidatorPlugin.java</exclude>
                  <exclude>com/kingsrook/qbits/webhooks/processes/ManageWebhookHealth*.java</exclude>
                  <exclude>com/kingsrook/qbits/webhooks/processes/SendTestEventToWebhook*.java</exclude>
                  <exclude>com/kingsrook/qbits/webhooks/processes/SendWebhookEvent*.java</exclude>
                  <exclude>com/kingsrook/qbits/webhooks/processes/SyncWebhookScheduledJobProcess.java</exclude>
               </excludes>
               <testExcludes>
                  <testExclude>com/kingsrook/qbits/webhooks/BaseTest.java</testExclude>
                  <testExclude>com/kingsrook/qbits/webhooks/WebhooksQBitConfigTest.java</testExclude>
                  <testExclude>com/kingsrook/qbits/webhooks/WebhooksTestApplication.java</testExclude>
                  <testExclude>com/kingsrook/qbits/webhooks/WebhooksTestJavalinServer.java</testExclude>
                  <testExclude>com/kingsrook/qbits/webhooks/WebhooksTestReceiver*.java</testExclude>
                  <testExclude>com/kingsrook/qbits/webhooks/actions/**</testExclude>
                  <testExclude>com/kingsrook/qbits/webhooks/processes/ManageWebhookHealthTransformStepTest.java</testExclude>
                  <testExclude>com/kingsrook/qbits/webhooks/processes/SendTestEventToWebhookLoadStepTest.java</testExclude>
                  <testExclude>com/kingsrook/qbits/webhooks/processes/SendWebhookEvent*Test.java</testExclude>
                  <testExclude>com/kingsrook/qbits/webhooks/registry/WebhooksRegistryValidationAndEnrichmentTest.java</testExclude>
               </testExcludes>
            </configuration>
         </plugin>
         <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-checkstyle-plugin</artifactId>
            <version>3.3.1</version>
            <dependencies>
               <dependency>
                  <groupId>com.puppycrawl.tools</groupId>
                  <artifactId>checkstyle</artifactId>
                  <version>10.12.6</version>
               </dependency>
            </dependencies>
            <configuration>
               <configLocation>checkstyle/config.xml</configLocation>
               <headerLocation>checkstyle/license.txt</headerLocation>
               <encoding>UTF-8</encoding>
               <consoleOutput>true</consoleOutput>
               <failsOnError>false</failsOnError>
               <failOnViolation>true</failOnViolation>
               <violationSeverity>warning</violationSeverity>
               <includeTestSourceDirectory>false</includeTestSourceDirectory>
               <!-- TEMPORARY (1.0 PR): the uncompiled 0.x sources, until their removal is approved. -->
               <excludes>com/kingsrook/qbits/webhooks/actions/**,com/kingsrook/qbits/webhooks/model/**,com/kingsrook/qbits/webhooks/tables/**,com/kingsrook/qbits/webhooks/registry/WebhooksRegistry*Plugin.java,com/kingsrook/qbits/webhooks/processes/ManageWebhookHealth*.java,com/kingsrook/qbits/webhooks/processes/SendTestEventToWebhook*.java,com/kingsrook/qbits/webhooks/processes/SendWebhookEvent*.java,com/kingsrook/qbits/webhooks/processes/SyncWebhookScheduledJobProcess.java</excludes>
            </configuration>
            <executions>
               <execution>
                  <id>validate</id>
                  <phase>validate</phase>
                  <goals>
                     <goal>check</goal>
                  </goals>
               </execution>
            </executions>
         </plugin>
         <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>${jacoco.version}</version>
            <executions>
               <execution>
                  <id>prepare-agent</id>
                  <goals>
                     <goal>prepare-agent</goal>
                  </goals>
               </execution>
               <execution>
                  <id>report</id>
                  <phase>verify</phase>
                  <goals>
                     <goal>report</goal>
                  </goals>
               </execution>
               <execution>
                  <id>check</id>
                  <goals>
                     <goal>check</goal>
                  </goals>
                  <configuration>
                     <rules>
                        <rule>
                           <element>BUNDLE</element>
                           <limits>
                              <limit>
                                 <counter>INSTRUCTION</counter>
                                 <value>COVEREDRATIO</value>
                                 <minimum>0.70</minimum>
                              </limit>
                              <limit>
                                 <counter>CLASS</counter>
                                 <value>COVEREDRATIO</value>
                                 <minimum>0.90</minimum>
                              </limit>
                           </limits>
                        </rule>
                     </rules>
                  </configuration>
               </execution>
            </executions>
         </plugin>
      </plugins>
   </build>

   <profiles>
      <!-- QQQ 4.1 APIs until qbit-build-parent imports the 4.1 BOM (as in qbit-quick-search and qbit-cdn, ADR-0007). -->
      <profile>
         <id>qqq-snapshot</id>
         <activation>
            <activeByDefault>true</activeByDefault>
         </activation>
         <properties>
            <qqq.snapshot.version>4.1.0-RC.4</qqq.snapshot.version>
         </properties>
         <dependencyManagement>
            <dependencies>
               <dependency>
                  <groupId>com.kingsrook.qqq</groupId>
                  <artifactId>qqq-bom-pom</artifactId>
                  <version>${qqq.snapshot.version}</version>
                  <type>pom</type>
                  <scope>import</scope>
               </dependency>
            </dependencies>
         </dependencyManagement>
      </profile>
   </profiles>
</project>
